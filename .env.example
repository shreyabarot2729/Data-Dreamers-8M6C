DATABASE_URL=postgresql+asyncpg://event_user:change_me@localhost:5432/event_registration
APP_ENV=development
OTP_PROVIDER=twilio
DATABASE_ECHO=false
SECRET_KEY=change-this-to-a-long-random-secret
OTP_TTL_SECONDS=300
APP_URL=http://127.0.0.1:8000
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FACE_PROVIDER=aws_rekognition
AWS_REGION=us-east-1
AWS_REKOGNITION_COLLECTION=eventsecure-participants
FACE_MATCH_THRESHOLD=90
AWS_ACCESS_KEY_ID=replace-with-an-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-an-aws-secret-key
VERIFY_FACE=true
VERIFY_LIVENESS=true
VERIFY_PAD=true
